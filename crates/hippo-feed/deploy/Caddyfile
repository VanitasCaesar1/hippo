# Caddy in front of hippo-feed. Install at /etc/caddy/Caddyfile.
#
# feed.example.org is a placeholder. The operator replaces it with the
# domain chosen for the feed, and the same name goes in FEED_BASE_URL in
# /etc/hippo-feed/env (as https://<domain>).
#
# Caddy gets and renews the TLS certificate from Let's Encrypt by itself, and
# redirects port 80 to https. The domain's DNS must already point at this
# server, and ports 80 and 443 must be open.
feed.example.org {
	# The feed listens here (FEED_BIND in the env file; the two must match).
	reverse_proxy 127.0.0.1:8080

	# No access log: the feed's design keeps client addresses out of every log.
	# Caddy writes no access log unless a `log` directive asks for one; this
	# says so on purpose, so nobody adds one by accident.
	log {
		output discard
	}
}
