# hippocamp-feed-backup.timer: runs hippocamp-feed-backup.service every night at
# 02:30 UTC. Install at /etc/systemd/system/hippocamp-feed-backup.timer and
# enable the timer, not the service: systemctl enable --now hippocamp-feed-backup.timer

[Unit]
Description=Nightly hippocamp feed backup

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
# If the machine was off at 02:30, run once when it is next up.
Persistent=true

[Install]
WantedBy=timers.target
