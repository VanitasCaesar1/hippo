# Settings for hippocamp-feed. Install at /etc/hippocamp-feed/env, owner root, group
# hippocamp-feed, mode 0640 (it holds the OAuth client secret).
#
# Format: one NAME=value per line, read by systemd. Put comments on their own
# lines, never after a value (they would become part of the value). A value
# with spaces goes in double quotes. Do not use $, backticks, backslashes or
# quote marks inside a value. An empty value (NAME=) counts as unset.
#
# Never commit the real file. This example holds no secrets.

# The public address, with no path: https://<domain>. Replace the placeholder
# with the operator's domain (the same one as in the Caddyfile).
FEED_BASE_URL=https://feed.example.org

# Where the server listens. Keep it on loopback; it must match the Caddyfile.
FEED_BIND=127.0.0.1:8080

# The SQLite file. Its directory is /var/lib/hippocamp-feed (the unit's StateDirectory).
FEED_DB=/var/lib/hippocamp-feed/feed.sqlite

# Production values. Do not change them.
# FEED_DEV=0: no http URLs, and no mock-oauth or seed-demo commands.
FEED_DEV=0
# FEED_TRUST_PROXY=1: the server is behind Caddy and takes the client address
# from the last X-Forwarded-For entry, the one Caddy adds.
FEED_TRUST_PROXY=1

# Secrets, from the GitHub OAuth app. Set both or neither; neither means
# nobody can sign in.
FEED_GITHUB_CLIENT_ID=
FEED_GITHUB_CLIENT_SECRET=

# Admins: comma-separated GitHub numeric ids, such as 1234567,7654321.
# An edit here takes effect after `systemctl restart hippocamp-feed`.
FEED_ADMINS=

# The registry index: a file path, or an https URL with no query or fragment,
# using only the characters A-Z a-z 0-9 . - _ ~ / :
# Empty means no registry sync at all.
FEED_REGISTRY_INDEX=

# Optional. Empty means the default shown after each name.
# Registry sync interval in minutes, 0 to 1440; 0 turns the sync off (default 15).
FEED_REGISTRY_SYNC_MINUTES=
# Where theme packs' stylesheets are fetched from (default https://raw.githubusercontent.com).
FEED_RAW_URL=
# The GitHub OAuth endpoints (defaults are GitHub's own; change only for a test provider).
FEED_OAUTH_AUTHORIZE_URL=
FEED_OAUTH_TOKEN_URL=
FEED_OAUTH_API_URL=
# Public eval sets, comma-separated <id>:<planted>:<kept>, such as 3f2a9c01b7d4:6:8.
# Empty means measuring is not open (default).
FEED_EVAL_SETS=
# Contact line shown on /about, 1 to 200 characters. Set one before the
# feed opens to members; quote it if it has spaces.
FEED_CONTACT=
