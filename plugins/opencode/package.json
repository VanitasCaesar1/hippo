{
  "name": "opencode-plugin-hippo",
  "version": "0.3.0",
  "description": "hippo for OpenCode: hippo's start block in each top-level session's system prompt, and tools to search past agent sessions and show a day's work.",
  "keywords": [
    "opencode-plugin",
    "opencode",
    "hippo",
    "memory",
    "context",
    "notes"
  ],
  "homepage": "https://github.com/VanitasCaesar1/hippo/tree/main/plugins/opencode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanitasCaesar1/hippo.git",
    "directory": "plugins/opencode"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18",
    "opencode": ">=2.2.0 <3.0.0"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "check-lib": "rm -rf lib && npm run compile && git status --porcelain -- lib && test -z \"$(git status --porcelain -- lib)\""
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
