# The Homebrew formula for hippo. scripts/release.sh fills the version,
# URLs and checksums and writes hippo.rb into the dist folder, for a tap.
class Hippo < Formula
  desc "One brain for all your coding agents"
  homepage "https://github.com/VanitasCaesar1/hippo"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "@URL_aarch64-apple-darwin@"
      sha256 "@SHA_aarch64-apple-darwin@"
    end
    on_intel do
      url "@URL_x86_64-apple-darwin@"
      sha256 "@SHA_x86_64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "@URL_aarch64-unknown-linux-musl@"
      sha256 "@SHA_aarch64-unknown-linux-musl@"
    end
    on_intel do
      url "@URL_x86_64-unknown-linux-musl@"
      sha256 "@SHA_x86_64-unknown-linux-musl@"
    end
  end

  def install
    bin.install "hippo"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/hippo --version")
  end
end
